{
  "name": "lablink",
  "version": "1.0.0",
  "description": "LabLink - Making college laboratories more accessible",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx server/src/index.ts",
    "dev:client": "vite client --port 5173",
